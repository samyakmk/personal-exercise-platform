{
  "name": "trainer-plus",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "build": "node --import ./scripts/expo-env.mjs node_modules/expo/bin/cli export --platform web",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "typecheck": "tsc --noEmit",
    "test:api": "node --test tests/*.test.mjs",
    "test:web": "playwright test",
    "eval:form": "node --env-file-if-exists=.env scripts/evaluate-form.mjs",
    "eval:ranking": "node --env-file-if-exists=.env scripts/evaluate-ranking.mjs",
    "prepare:form": "node scripts/prepare-form-clips.mjs",
    "setup:pose": "node scripts/setup-pose.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "expo": "57.0.28",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.2",
    "expo-document-picker": "~57.0.3",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.12",
    "expo-router": "~57.0.26",
    "expo-video": "~57.0.5",
    "jpeg-js": "0.4.4",
    "lucide-react-native": "^0.577.0",
    "onnxruntime-node": "1.31.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/react": "~19.2.10",
    "typescript": "~5.9.3"
  }
}
